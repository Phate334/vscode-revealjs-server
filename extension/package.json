{
  "name": "vscode-revealjs-collaboration",
  "displayName": "RevealJS Collaboration (PoC)",
  "description": "Collaborative Reveal.js presentations: CRDT slide sync + project snapshot",
  "version": "0.0.1",
  "publisher": "phate334",
  "engines": {
    "vscode": "^1.139.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:revealjsCollab.connect",
    "workspaceContains:.presentation/workspace.json",
    "onCommand:presentation.createProject",
    "onCommand:presentation.openProject",
    "onCommand:presentation.openPreview",
    "onCommand:presentation.signIn",
    "onCommand:presentation.openSharedProject",
    "onCommand:presentation.shareProject",
    "onCommand:presentation.projectMembers",
    "onCommand:presentation.publish"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "revealjsCollab.connect",
        "title": "RevealJS Collab: Connect"
      },
      {
        "command": "revealjsCollab.disconnect",
        "title": "RevealJS Collab: Disconnect"
      },
      {
        "command": "presentation.undo",
        "title": "Presentation: Undo"
      },
      {
        "command": "presentation.redo",
        "title": "Presentation: Redo"
      },
      {
        "command": "presentation.createProject",
        "title": "Presentation: Create Project"
      },
      {
        "command": "presentation.openProject",
        "title": "Presentation: Open Project"
      },
      {
        "command": "presentation.signIn",
        "title": "Presentation: Sign In"
      },
      {
        "command": "presentation.openSharedProject",
        "title": "Presentation: Open Shared Project"
      },
      {
        "command": "presentation.shareProject",
        "title": "Presentation: Share Project"
      },
      {
        "command": "presentation.projectMembers",
        "title": "Presentation: Project Members"
      },
      {
        "command": "presentation.publish",
        "title": "Presentation: Publish"
      },
      {
        "command": "presentation.openPreview",
        "title": "Presentation: Open Preview"
      }
    ],
    "keybindings": [
      {
        "command": "presentation.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "presentation.collaborativeEditor && editorTextFocus"
      },
      {
        "command": "presentation.redo",
        "key": "ctrl+y",
        "mac": "cmd+shift+z",
        "when": "presentation.collaborativeEditor && editorTextFocus"
      },
      {
        "command": "presentation.redo",
        "key": "ctrl+shift+z",
        "when": "presentation.collaborativeEditor && editorTextFocus"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p ."
  },
  "dependencies": {
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.138.0",
    "typescript": "^5.8.2"
  }
}
