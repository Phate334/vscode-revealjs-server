{
  "name": "vscode-revealjs-collaboration",
  "displayName": "RevealJS Collaboration",
  "description": "Collaborative presentations with durable local workspaces and private live preview",
  "version": "0.1.2",
  "publisher": "phate334",
  "engines": {
    "vscode": "^1.139.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:revealjsCollab.connect",
    "workspaceContains:.presentation/workspace.json",
    "onCommand:presentation.createProject",
    "onCommand:presentation.openProject",
    "onCommand:presentation.openPreview",
    "onCommand:presentation.signIn",
    "onCommand:presentation.shareProject",
    "onCommand:presentation.projectMembers",
    "onCommand:presentation.publish",
    "onCommand:presentation.acceptInvitation"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "revealjsCollab.connect",
        "title": "Presentation: Connect"
      },
      {
        "command": "revealjsCollab.disconnect",
        "title": "Presentation: Disconnect"
      },
      {
        "command": "presentation.undo",
        "title": "Presentation: Undo"
      },
      {
        "command": "presentation.redo",
        "title": "Presentation: Redo"
      },
      {
        "command": "presentation.createProject",
        "title": "Presentation: Create Presentation"
      },
      {
        "command": "presentation.openProject",
        "title": "Presentation: Open Presentation"
      },
      {
        "command": "presentation.signIn",
        "title": "Presentation: Sign In"
      },
      {
        "command": "presentation.shareProject",
        "title": "Presentation: Share Presentation"
      },
      {
        "command": "presentation.projectMembers",
        "title": "Presentation: Project Members"
      },
      {
        "command": "presentation.publish",
        "title": "Presentation: Publish"
      },
      {
        "command": "presentation.openPreview",
        "title": "Presentation: Open Preview"
      },
      {
        "command": "presentation.acceptInvitation",
        "title": "Presentation: Accept Invitation"
      },
      {
        "command": "presentation.syncDetails",
        "title": "Presentation: Synchronization Details"
      },
      {
        "command": "presentation.retrySync",
        "title": "Presentation: Retry Synchronization"
      },
      {
        "command": "presentation.resolveConflict",
        "title": "Presentation: Resolve Conflict"
      }
    ],
    "keybindings": [
      {
        "command": "presentation.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "presentation.collaborativeEditor && editorTextFocus"
      },
      {
        "command": "presentation.redo",
        "key": "ctrl+y",
        "mac": "cmd+shift+z",
        "when": "presentation.collaborativeEditor && editorTextFocus"
      },
      {
        "command": "presentation.redo",
        "key": "ctrl+shift+z",
        "when": "presentation.collaborativeEditor && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Presentation",
      "properties": {
        "presentation.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Server origin for sign-in, creating and opening presentations. Existing workspaces retain their recorded origin."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p ."
  },
  "dependencies": {
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.138.0",
    "typescript": "^5.8.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Phate334/vscode-revealjs-server.git"
  }
}
